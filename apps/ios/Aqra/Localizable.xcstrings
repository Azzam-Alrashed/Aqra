                  "state": "translated",
                  "value": "%lld آية"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld آية"
                }
              }
            }
          }
        }
      }
    },
    "%lld ayat memorized": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ayah memorized"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld ayat memorized"
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "لا آيات محفوظة"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "آية واحدة محفوظة"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "آيتان محفوظتان"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld آيات محفوظة"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld آية محفوظة"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld آية محفوظة"
                }
              }
            }
          }
