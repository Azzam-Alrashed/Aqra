{
  "sourceLanguage": "en",
  "strings": {
    "Aqra": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ"
          }
        }
      }
    },
    "Begin": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ"
          }
        }
      }
    },
    "Read and ascend": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ وارتقِ"
          }
        }
      }
    },
    "Reported by Ahmad": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رواه أحمد"
          }
        }
      }
    },
    "Translation: Jami' at-Tirmidhi 2914, Darussalam": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمة: جامع الترمذي 2914، دار السلام"
          }
        }
      }
    },
    "Strengthen your memorization,": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبِّت حفظك،"
          }
        }
      }
    },
    "and rise, ayah by ayah.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وارتقِ آيةً بعد آية"
          }
        }
      }
    },
    "Revise every day, and climb your stations in Aqra.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجِع كل يوم، وارتقِ في منازلك على اقرأ."
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة"
          }
        }
      }
    },
    "Everything that helps your memorization,": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما يُعينك على حفظك"
          }
        }
      }
    },
    "in one place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في مكان واحد"
          }
        }
      }
    },
    "Daily revision, tasmee' with qualified teachers, and rewards that motivate you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراجعة يومية، وتسميع على شيوخ مُجازين، ومكافآت تحفّزك."
          }
        }
      }
    },
    "Save your progress,": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ تقدّمك"
          }
        }
      }
    },
    "and begin your journey.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وابدأ رحلتك"
          }
        }
      }
    },
    "Sign in to keep your revision and stations, and to book tasmee' with teachers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول لتحفظ مراجعتك ومنازلك، وتحجز تسميعك مع الشيوخ."
          }
        }
      }
    },
    "Continue with Google": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستمرار باستخدام Google"
          }
        }
      }
    },
    "Continue without an account": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المتابعة بدون حساب"
          }
        }
      }
    }
  },
  "version": "1.1"
}