              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld آية"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "آية واحدة"
                }
              },
              "two": {
                "stringUnit": {
