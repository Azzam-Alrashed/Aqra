    "%@ cancelled a session you were in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألغى %@ جلسة كنت فيها."
          }
        }
      }
    },
    "%@ cancelled a session: your %lld credits are back." : {
