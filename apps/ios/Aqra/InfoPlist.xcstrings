    "NSCameraUsageDescription" : {
      "comment" : "Why Aqra asks for the camera.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليراك معلّمك وأنت تُسمِّع في التسميع المرئي، ولتقرأ رمز صديقك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your teacher sees you while you recite, and you can scan a friend's code."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Why Aqra asks for the microphone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليتابع اقرأ تلاوتك وأنت تراجع، على جهازك، وليسمعك معلّمك في التسميع المرئي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Aqra follows along as you recite a revision, on your device, and your teacher hears you in a video tasmee'."
          }
        }
      }
    }
  },
  "version" : "1.0"
