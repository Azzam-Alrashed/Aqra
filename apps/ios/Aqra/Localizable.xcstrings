{
  "sourceLanguage": "en",
  "strings": {
    "Begin": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ"
          }
        }
      }
    },
    "Reported by Ahmad": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رواه أحمد"
          }
        }
      }
    },
    "Translation: Jami' at-Tirmidhi 2914, Darussalam": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمة: جامع الترمذي 2914، دار السلام"
          }
        }
      }
    },
    "Strengthen your memorization,": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبِّت حفظك،"
          }
        }
      }
    },
    "and rise, ayah by ayah.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وارتقِ آيةً بعد آية"
          }
        }
      }
    },
    "Revise every day, and climb your stations in Aqra.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجِع كل يوم، وارتقِ في منازلك على اقرأ."
          }
        }
      }
    },
    "Continue": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متابعة"
          }
        }
      }
    },
    "Everything that helps your memorization,": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما يُعينك على حفظك"
          }
        }
      }
    },
    "in one place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في مكان واحد"
          }
        }
      }
    },
    "Daily revision, tasmee' with qualified teachers, and rewards that motivate you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراجعة يومية، وتسميع على شيوخ مُجازين، ومكافآت تحفّزك."
          }
        }
      }
    },
    "Everything is ready,": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء جاهز،"
          }
        }
      }
    },
    "begin your journey.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ رحلتك"
          }
        }
      }
    },
    "Your progress is saved on your device, and you can link it to your account anytime.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدّمك يُحفظ على جهازك، ويمكنك ربطه بحسابك متى شئت."
          }
        }
      }
    },
    "The Mushaf couldn't be loaded": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل المصحف"
          }
        }
      }
    },
    "Index": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفهرس"
          }
        }
      }
    },
    "Surahs": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السور"
          }
        }
      }
    },
    "Juz'": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجزاء"
          }
        }
      }
    }
  },
  "version": "1.1"
}